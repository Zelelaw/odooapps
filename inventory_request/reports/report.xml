<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_project_detail" model="ir.actions.report">
            <field name="name">Project Detail</field>
            <field name="model">wood.flex.projects</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">woodflex_request.report_project_detail</field>
            <field name="report_file">woodflex_request.report_project_detail</field>
            <field name="print_report_name">('RFQ - %s' % (object.project_id))</field>
            <field name="binding_model_id" ref="model_wood_flex_projects"/>
            <field name="binding_type">report</field>
        </record>

         <record id="action_report_project_summary" model="ir.actions.report">
            <field name="name">Project Summary</field>
            <field name="model">wood.flex.projects</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">woodflex_request.report_project_summary</field>
            <field name="report_file">woodflex_request.report_project_summary</field>
            <field name="print_report_name">('PS - %s' % (object.project_id))</field>
            <field name="binding_model_id" ref="model_wood_flex_projects"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>