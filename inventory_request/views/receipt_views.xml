<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="tree_woodfelx_receipt" model="ir.ui.view">
        <field name="name">woodfelx.receipt.tree</field>
        <field name="model">woodfelx.receipt</field>
        <field name="arch" type="xml">
            <tree string="Receipt">
                <field name="serial_number"/>
                <field name="prepared_by"/>
                <field name="items"/>
                <field name="date"/>
                <field name="client"/>
                <field name="site"/>
            </tree>
        </field>
    </record>

    <record id="woodfelx_receipt_form" model="ir.ui.view">
        <field name="name">woodfelx.receipt.form</field>
        <field name="model">woodfelx.receipt</field>
        <field name="arch" type="xml">
            <form string="Woodfelx Receipt">
                <header>
                    <button name="send_for_approval" string="Send for Approval" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="approved" string="Approve  as Manager" type="object"
                            class="oe_highlight" invisible="state != 'waiting_approval'"/>
                    <button name="delivered" string="Delivered" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="set_to_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="cancel" string="Cancel" type="object"
                            invisible="state in ('approved','delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="serial_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="prepared_by" readonly="1"/>
                            <field name="items"/>
                            <field name="date"/>
                            <field name="client"/>
                            <field name="site"/>
                            <field name="for_project" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="contract_amount"/>
                            <field name="payment_number"/>
                            <field name="amount_in_word"/>
                            <field name="balance"/>
                            <field name="sign"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_receipt" model="ir.actions.act_window">
        <field name="name">Woodfelx Receipt</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">woodfelx.receipt</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Receipt
            </p>
        </field>
    </record>

    <menuitem id="menu_receipt"
          name="Receipt"
          parent="woodflex_request.menu_woodflex_requests"
          sequence="2"
          groups="woodflex_request.group_store_man,woodflex_request.group_finance_officer,woodflex_request.group_general_manager"
          action="action_receipt"/>


    <!--    <menuitem id="submenu_receipt"-->
    <!--              name="New Request"-->
    <!--              parent="menu_receipt"-->
    <!--              action="action_receipt"/>-->
</odoo>