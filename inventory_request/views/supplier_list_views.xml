<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="tree_supplier_list" model="ir.ui.view">
        <field name="name">supplier.list.tree</field>
        <field name="model">supplier.list</field>
        <field name="arch" type="xml">
            <tree string="Supplier List">
                <field name="name"/>
                <field name="address"/>
                <field name="phone"/>
                <field name="email"/>
            </tree>
        </field>
    </record>
    
    <record id="supplier_list_form" model="ir.ui.view">
        <field name="name">supplier.list.form</field>
        <field name="model">supplier.list</field>
        <field name="arch" type="xml">
            <form string="Supplier List">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="created_by" string="Issued By"
                                   readonly="1"
                                   help="A person who issue the Supplier List"/>
                            <field name="name" />
                            <field name="address"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    
    <record id="action_supplier_list" model="ir.actions.act_window">
        <field name="name">Supplier List</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">supplier.list</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Supplier List
            </p>
        </field>
    </record>

    <menuitem id="menu_supplier_list"
              name="Supplier List"
              parent="woodflex_request.menu_woodflex_requests"
              action="action_supplier_list"
              sequence="4"/>


</odoo>