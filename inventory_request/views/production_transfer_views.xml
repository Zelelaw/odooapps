<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tree_production_transfer" model="ir.ui.view">
        <field name="name">production.transfer.tree</field>
        <field name="model">production.transfer</field>
        <field name="arch" type="xml">
            <tree string="Production Transfer">
                <field name="reference_number"/>
                <field name="prepared_by"/>
                <field name="site"/>
                <field name="date"/>
                <field name="client_name"/>
                <field name="for_project"/>
                <field name="company_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="production_transfer_form" model="ir.ui.view">
        <field name="name">production.transfer.form</field>
        <field name="model">production.transfer</field>
        <field name="arch" type="xml">
            <form string="Production Transfer">
                <header>
                    <button name="send_for_approval" string="Send for Approval" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="approved" string="Approve  as Manager" type="object"
                            class="oe_highlight" invisible="state != 'waiting_approval'"/>
                    <button name="delivered" string="Delivered" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="set_to_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="cancel" string="Cancel" type="object"
                            invisible="state in ('approved','delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="reference_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="prepared_by" string="Prepared By"
                                   readonly="1"
                                   help="A person who issue the Production Transfer"/>
                            <field name="date"/>
                            <field name="site"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"
                                   readonly="1"/>
                            <field name="client_name"/>
                            <field name="for_project" options="{'no_create': True}"/>
                        </group>
                        <notebook>
                            <page string="Item Detail">
                                <field name="production_transfer_line" mode="tree"
                                       options="{'reload_whole_on_button': true}">
                                    <tree editable="bottom">
                                        <field name="item" required="1"/>
                                        <field name="quantity"/>
                                        <field name="unit"/>
                                        <field name="remain_work"/>
                                        <field name="remark"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_production_transfer" model="ir.actions.act_window">
        <field name="name">Production Transfer</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">production.transfer</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Production Transfer
            </p>
        </field>
    </record>


