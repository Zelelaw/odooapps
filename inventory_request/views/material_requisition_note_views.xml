<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tree_material_requisition_note" model="ir.ui.view">
        <field name="name">material.requisition.note.tree</field>
        <field name="model">material.requisition.note</field>
        <field name="arch" type="xml">
            <tree string="Material Requisition Note">
                <field name="serial_number"/>
                <field name="prepared_by"/>
                <field name="team_leader_name"/>
                <field name="client_name"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <record id="material_requisition_note_form" model="ir.ui.view">
        <field name="name">material.requisition.note.form</field>
        <field name="model">material.requisition.note</field>
        <field name="arch" type="xml">
            <form string="Material Requisition Note">
                <header>
                    <button name="send_for_approval" string="Send for Approval" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="approved" string="Approve  as Manager" type="object"
                            class="oe_highlight" invisible="state != 'waiting_approval'"/>
                    <button name="delivered" string="Delivered" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="set_to_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="cancel" string="Cancel" type="object"
                            invisible="state in ('approved','delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="serial_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="prepared_by"
                                   readonly="1"
                                   help="A person who issue the Material Requisition Note"/>
                            <field name="team_leader_name"/>
                            <field name="section_name"/>
                            <field name="client_name"/>
                            <field name="for_project" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"
                                   readonly="1"/>
                            <field name="date"/>
                            <field name="approved_by"/>

                        </group>
                        <notebook>
                            <page string="Purchased Item Detail">
                                <field name="material_requisition_note_line" mode="tree"
                                       options="{'reload_whole_on_button': true}">
                                    <tree editable="bottom">
                                        <field name="item" required="1"/>
                                        <field name="unit"/>
                                        <field name="quantity"/>
                                        <field name="remark"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_material_requisition_note" model="ir.actions.act_window">
        <field name="name">Material Requisition Note</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">material.requisition.note</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Material Requisition Note
            </p>
        </field>
    </record>


    <menuitem id="menu_material_requisition_note"
              name="Material Requisition Note"
              parent="woodflex_request.menu_woodflex_requests"
              groups="woodflex_request.group_store_man,woodflex_request.group_production_manager,woodflex_request.group_general_manager"
              action="action_material_requisition_note"
              sequence="4"/>

<!--    <menuitem id="submenu_material_requisition_note"-->
<!--              name="New Request"-->
<!--              parent="menu_material_requisition_note"-->
<!--              action="action_material_requisition_note"/>-->
</odoo>