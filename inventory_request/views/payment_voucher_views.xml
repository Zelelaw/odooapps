<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tree_payment_voucher" model="ir.ui.view">
        <field name="name">payment.voucher.tree</field>
        <field name="model">payment.voucher</field>
        <field name="arch" type="xml">
            <tree string="Payment Voucher">
                <field name="serial_number"/>
                <field name="prepared_by"/>
                <field name="date"/>
                <field name="supplier"/>
                <field name="approved_by"/>
            </tree>
        </field>
    </record>

    <record id="payment_voucher_form" model="ir.ui.view">
        <field name="name">payment.voucher.form</field>
        <field name="model">payment.voucher</field>
        <field name="arch" type="xml">
            <form string="Payment Voucher">
                <header>
                    <button name="send_for_approval" string="Send for Approval" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="approved" string="Approve  as Manager" type="object"
                            class="oe_highlight" invisible="state != 'waiting_approval'"/>
                    <button name="delivered" string="Delivered" type="object"
                            class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="set_to_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="cancel" string="Cancel" type="object"
                            invisible="state in ('approved','delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="serial_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="prepared_by" string="Prepared By"
                                   readonly="1"
                                   help="A person who issue the Payment Voucher"/>
                            <field name="date" string="Order Date"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"
                                   readonly="1"/>
                            <field name="supplier"/>
                            <field name="for_project" options="{'no_create': True}"/>
                            <field name="approved_by" string="Approved By"/>
                        </group>
                        <notebook>
                            <page string="Purchased Item Detail">
                                <field name="payment_voucher_line" mode="tree"
                                       options="{'reload_whole_on_button': true}">
                                    <tree editable="bottom">
                                        <field name="item" required="1"/>
                                        <field name="unit"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="amount"/>
                                        <field name="remark"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_payment_voucher" model="ir.actions.act_window">
        <field name="name">Payment Voucher</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">payment.voucher</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Payment Voucher
            </p>
        </field>
    </record>


    <menuitem id="menu_payment_voucher"
              name="Payment Voucher"
              parent="woodflex_request.menu_woodflex_requests"
              sequence="3"
              groups="woodflex_request.group_finance_officer"
              action="action_payment_voucher"/>
</odoo>