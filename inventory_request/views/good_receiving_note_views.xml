<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="tree_good_receiving_note" model="ir.ui.view">
        <field name="name">good.receiving.note.tree</field>
        <field name="model">good.receiving.note</field>
        <field name="arch" type="xml">
            <tree string="Good Receiving Note">
                <field name="serial_number"/>
                <field name="prepared_by"/>
                <field name="date"/>
                <field name="local_purchase_order_number"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="good_receiving_note_form" model="ir.ui.view">
        <field name="name">good.receiving.note.form</field>
        <field name="model">good.receiving.note</field>
        <field name="arch" type="xml">
            <form string="Good Receiving Note">
                <header>
                    <button name="send_for_approval" string="Send for Approval" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>

                    <button name="send_for_purchaser" string="Approve as Manager" type="object"
                            class="oe_highlight" invisible="state != 'waiting_approval'"
                            groups="woodflex_request.group_production_manager"/>

                    <button name="send_for_finance" string="Approve as Purchaser" type="object"
                            class="oe_highlight" invisible="state != 'waiting_purchaser_approval'"
                            groups="woodflex_request.group_purchaser"/>

                    <button name="approved" string="Approve as Finance Officer" type="object"
                            class="oe_highlight" invisible="state != 'waiting_finance_approval'"
                            groups="woodflex_request.group_finance_officer"/>

                    <button name="delivered" string="Delivered" type="object"
                            class="oe_highlight" invisible="state != 'approved'"
                            groups="woodflex_request.group_store_man"/>
                    <button name="set_to_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'"/>

                    <button name="cancel" string="Cancel" type="object"
                            invisible="state in ('approved','delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="serial_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="prepared_by"
                                   readonly="1"/>
                            <field name="local_purchase_order_number" options="{'no_create': True}"/>
<!--                            <field name="supplier_name"/>-->
                            <field name="for_project" options="{'no_create': True}"/>
<!--                            <field name="phone_number"/>-->
<!--                            <field name="delivered_by"/>-->
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"
                                   readonly="1"/>
                            <field name="date"/>
                            <field name="receipt_attachment" widget="many2many_binary"
                                   class="oe_inline"/>
<!--                            <field name="payment_type"/>-->
<!--                            <field name="advance_payment" invisible="payment_type != 'credit'"/>-->
                        </group>
                        <notebook>
                            <page string="Received Item Detail">
                                <field name="good_receiving_note_line" mode="tree"
                                       options="{'reload_whole_on_button': true}" >
                                    <tree editable="bottom" create="false">
                                        <field name="item" required="1" readonly="true"/>
                                        <field name="unit" readonly="true"/>
                                        <field name="quantity" readonly="true"/>
                                        <field name="received_quantity"/>
                                        <field name="unit_price" readonly="true"/>
                                        <field name="amount" readonly="true"/>
                                        <field name="supplier" readonly="true"/>
                                        <field name="remark" />
                                    </tree>
                                </field>
                                <group col="12" class="oe_invoice_lines_tab">
                                    <group colspan="8">
                                    </group>
                                    <group colspan="4">
                                        <group class="oe_subtotal_footer">
                                            <field name="total" readonly="1"/>
                                        </group>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_good_receiving_note" model="ir.actions.act_window">
        <field name="name">Good Receiving Note</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">good.receiving.note</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Good Receiving Note
            </p>
        </field>
    </record>


    <menuitem id="menu_good_receiving_note"
              name="Good Receiving Note"
              parent="woodflex_request.menu_woodflex_requests"
              sequence="4"
              groups="woodflex_request.group_store_man"
              action="action_good_receiving_note"/>

</odoo>